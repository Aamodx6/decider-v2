    {
      "type": "text",
      "id": "a_mix_t",
      "x": 90,
      "y": 1188,
      "width": 560,
      "height": 165,
      "text": "choice      44.75%   most rows carry only 2 options\nnoul        41.52%   23.44% already have an abstention key\nscore       13.73%\n\nnumeric_temporal     19,806 rows · 43 calculation types\ncounterfactual_15k    7,500 label-flipping pairs\nlabel_probs           8,131 rows carry soft labels\n\np99 state length = 958 tokens\nonly 7.75% of rows exceed 1,024\n6.03% of choice questions answer with an abstention",
      "originalText": "choice      44.75%   most rows carry only 2 options\nnoul        41.52%   23.44% already have an abstention key\nscore       13.73%\n\nnumeric_temporal     19,806 rows · 43 calculation types\ncounterfactual_15k    7,500 label-flipping pairs\nlabel_probs           8,131 rows carry soft labels\n\np99 state length = 958 tokens\nonly 7.75% of rows exceed 1,024\n6.03% of choice questions answer with an abstention",
      "fontSize": 12,

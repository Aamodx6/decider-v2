    {
      "type": "text",
      "id": "t2_cap",
      "x": 960,
      "y": 1922,
      "width": 830,
      "height": 22,
      "text": "TIER 2 — FLAGS ON THE SAME train.py · ablations, one at a time",
      "originalText": "TIER 2 — FLAGS ON THE SAME train.py · ablations, one at a time",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b45309",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

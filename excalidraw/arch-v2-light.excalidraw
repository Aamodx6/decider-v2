    {
      "type": "text",
      "id": "t1_cap",
      "x": 70,
      "y": 1922,
      "width": 850,
      "height": 22,
      "text": "TIER 1 — ALWAYS IMPLEMENTED · this is what defines v2",
      "originalText": "TIER 1 — ALWAYS IMPLEMENTED · this is what defines v2",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 61014,
      "version": 1,
      "versionNonce": 62014,
      "isDeleted": false,
      "groupIds": [],

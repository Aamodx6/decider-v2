# Python-generated files
__pycache__/
.pytest_cache/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Training runs (LoRA + head checkpoints, metrics)
runs/

# macOS
.DS_Store

# Local environments and training/benchmark artifacts.
# These are anchored to the project root on purpose: an unanchored `data/` would also
# match bev-decision/data/, which holds the `default` config's parquet (35 MB) and is
# one of the five files the `all` config concatenates.
.env
.envrc
.local-experiments/
/jevbench/
/bench/
/data/
/server_logs/

# Local experiment recipes, notes, and cloud setup alias
build_data_*.py
EXPERIMENTS.md
expt_monitoring.md
setup_cloud.sh
configs/v*_lora*.yaml
configs/full_lora_k8*.yaml

# Captured run output and one-off scratch probes (never commit these; they hardcode
# local run ids and machine-specific paths, so they break for everyone else)
*.log
*.txt
!requirements*.txt
prof*.py
bs_sweep*.py
time_eval*.py
conc_test*.sh
